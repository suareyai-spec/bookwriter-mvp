# Database (Prisma / Postgres — must be Neon with the pgvector extension
# available, since this is also queried directly for the RAG knowledge base;
# see lib/embeddings.ts and prisma/migrations/0009_pgvector_knowledge_embeddings)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://plotghost.ai"

# Anthropic (book/content generation)
ANTHROPIC_API_KEY=""

# OpenAI (RAG style-reference embeddings only — text-embedding-3-small).
# If unset, getStyleExamples() silently returns no results and generation
# proceeds without style injection.
OPENAI_API_KEY=""

# Stripe (subscriptions, credit packs, webhooks)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (transactional email — generation complete / failed notifications)
# Sends from noreply@plotghost.ai. If unset, emails are skipped (logged only).
RESEND_API_KEY=""

# Upstash Redis (rate limiting: 3 concurrent / 10 per hour / 50 per day generations).
# If unset, rate limiting falls back to an in-memory store (fine for local dev /
# single-instance deploys, but won't be shared across serverless instances).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
